---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const cargos = (await getCollection('cargos')).sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base title="PoliticaBR — Entenda o sistema político brasileiro">
  <section class="hero wrap">
    <h1>Entenda quem você elege.</h1>
    <p>Um guia claro sobre os cargos que você vota e sobre como funciona o poder no Brasil.</p>
  </section>

  <section class="wrap">
    <h2 class="section-title">Os cargos</h2>
    <ul class="cargo-list">
      {cargos.map((c) => (
        <li>
          <a href={`/cargos/${c.id}/`}>
            <strong>{c.data.nome}</strong>
            <span>{c.data.resumo}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero { padding-block: 4rem 1.5rem; }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 4.5rem); margin: 0; max-width: 14ch; line-height: 1.04; }
  .hero p { font-size: 1.25rem; color: var(--muted); max-width: 46ch; margin: 1.1rem 0 0; }

  .section-title { font-size: 1.5rem; margin: 2.5rem 0 1rem; }
  .cargo-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
  .cargo-list a { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem 1.25rem; background: var(--bg); text-decoration: none; }
  .cargo-list a:hover { background: var(--surface); }
  .cargo-list strong { font-family: var(--serif); font-weight: 600; font-size: 1.15rem; }
  .cargo-list span { color: var(--muted); font-size: 0.95rem; }
</style>
